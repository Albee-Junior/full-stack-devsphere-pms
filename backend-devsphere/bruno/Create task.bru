meta {
  name: Create task
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/tasks
  body: json
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Review Bruno API flow",
    "description": "Update this task after creating it.",
    "priority": "Medium",
    "projectId": {{projectId}}
  }
}

script:post-response {
  bru.setEnvVar("taskId", res.body.task.id.toString());
}

assert {
  res.status: 201
}