NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# These credentials match backend-devsphere/compose.yaml and are local-only.
DATABASE_URL=postgres://devsphere:devsphere_local@localhost:5432/devsphere
DATABASE_SSL=false
JWT_SECRET=replace-this-with-a-long-random-secret

DEMO_EMAIL=demo@devsphere.local
DEMO_PASSWORD=devsphere123

# Optional: add provider test credentials only when testing payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional SQLite migration source. Default: ../devsphere/data/devsphere.sqlite
SOURCE_SQLITE_PATH=
