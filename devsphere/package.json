{
  "name": "devsphere",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm --prefix ../backend-devsphere run dev\" \"vite\"",
    "dev:web": "vite",
    "server": "npm --prefix ../backend-devsphere start",
    "server:dev": "npm --prefix ../backend-devsphere run dev",
    "build": "vite build",
    "lint": "eslint src tests && npm --prefix ../backend-devsphere run lint",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix ../backend-devsphere test",
    "test:watch": "vitest",
    "start": "node server/server.js"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "vitest": "^5.1.0",
    "vite": "^8.3.5"
  }
}
